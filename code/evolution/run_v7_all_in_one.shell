#!/usr/bin/env bash
set -Eeuo pipefail

# Portable launcher for one v7.2 evolutionary execution unit.
# The paper's three-round experiment iterates this execution unit externally,
# using the preceding round's produced trajectories/population as the next
# round's input. This wrapper intentionally does not fabricate that experiment-
# specific orchestration.

CODE_DIR="${RESI_MATH_EVOLUTION_CODE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
INPUT_JSONL="${RESI_MATH_EVOLUTION_INPUT_JSONL:-}"
SAMPLE_MANIFEST="${RESI_MATH_EVOLUTION_SAMPLE_MANIFEST:-}"
OUTPUT_ROOT="${RESI_MATH_EVOLUTION_OUTPUT_ROOT:-${CODE_DIR}/../../outputs/evolution_v7}"
MODEL_PATH="${RESI_MATH_MODEL_PATH:-/data/Qwen/Qwen3-VL-8B-Instruct}"
ENTRY="${CODE_DIR}/run_self_judge_fusion_v7_wemath_dpo.py"

GPU_IDS="${RESI_MATH_GPU_IDS:-0}"
TP_SIZE="${RESI_MATH_TP_SIZE:-1}"
RUN_ID="${RESI_MATH_RUN_ID:-$(date +%Y%m%d_%H%M%S)}"

if [[ -z "${INPUT_JSONL}" || -z "${SAMPLE_MANIFEST}" ]]; then
  cat >&2 <<'MSG'
Set the two authorized local-data paths before running:
  RESI_MATH_EVOLUTION_INPUT_JSONL=/path/to/input.jsonl
  RESI_MATH_EVOLUTION_SAMPLE_MANIFEST=/path/to/SAMPLE_MANIFEST.jsonl
Original benchmark examples and images are not redistributed in this artifact.
MSG
  exit 2
fi

require_file() {
  local path="$1"
  local label="$2"
  if [[ ! -f "$path" ]]; then
    echo "Missing ${label}: ${path}" >&2
    exit 1
  fi
}

require_file "$ENTRY" "v7 entrypoint"
require_file "$INPUT_JSONL" "evolution input JSONL"
require_file "$SAMPLE_MANIFEST" "sample manifest"
require_file "$CODE_DIR/verifier_v4.py" "verifier_v4.py"

# The released verifier is byte-identical to the recovered experiment file.
EXPECTED_VERIFIER_SHA="3fd987bb949461f12c128946169e4776f322e884cfbb75309e22412c4b45774f"
ACTUAL_VERIFIER_SHA="$(python3 - "$CODE_DIR/verifier_v4.py" <<'PY'
import hashlib, pathlib, sys
p = pathlib.Path(sys.argv[1])
print(hashlib.sha256(p.read_bytes()).hexdigest())
PY
)"
if [[ "$ACTUAL_VERIFIER_SHA" != "$EXPECTED_VERIFIER_SHA" ]]; then
  echo "verifier_v4.py hash mismatch; refusing to run." >&2
  echo "expected=$EXPECTED_VERIFIER_SHA" >&2
  echo "actual=$ACTUAL_VERIFIER_SHA" >&2
  exit 1
fi

LOG_ROOT="${OUTPUT_ROOT}/logs"
mkdir -p "$LOG_ROOT"
MASTER_LOG="${LOG_ROOT}/v7_all_in_one_${RUN_ID}.log"
exec > >(tee -a "$MASTER_LOG") 2>&1

cd "$CODE_DIR"

echo "[1/4] CPU/mock unit tests"
python3 -m unittest discover -s tests -p 'test_*.py' -v

run_experiment() {
  local label="$1"
  local output_jsonl="$2"
  local run_dir="$3"
  shift 3

  if [[ -e "$output_jsonl" || -d "$run_dir" ]]; then
    echo "Refusing to overwrite existing output: $output_jsonl or $run_dir" >&2
    return 1
  fi
  mkdir -p "$run_dir"

  echo "Running ${label}: ${output_jsonl}"
  CUDA_VISIBLE_DEVICES="$GPU_IDS" python3 "$ENTRY" \
    --dataset-kind pro \
    --sample-manifest "$SAMPLE_MANIFEST" \
    --input-jsonl "$INPUT_JSONL" \
    --output-jsonl "$output_jsonl" \
    --run-dir "$run_dir" \
    --model-path "$MODEL_PATH" \
    --tensor-parallel-size "$TP_SIZE" \
    --max-model-len 32768 \
    --round0-count 16 \
    --children-per-operator 2 \
    --hinted-control-fraction 0.10 \
    --solver-max-tokens 4096 \
    --crossover-max-tokens 4096 \
    --judge-max-tokens 2048 \
    --process-judge-max-tokens 2048 \
    --duplicate-retries 4 \
    --seed 42 \
    "$@" \
    >"$run_dir/stdout.log" \
    2>"$run_dir/stderr.log"
}

DRY_OUTPUT="${OUTPUT_ROOT}/v7_dryrun_${RUN_ID}.jsonl"
SMOKE_OUTPUT="${OUTPUT_ROOT}/v7_smoke_${RUN_ID}.jsonl"
FULL_OUTPUT="${OUTPUT_ROOT}/v7_full_${RUN_ID}.jsonl"
DRY_RUN_DIR="${DRY_OUTPUT%.jsonl}_artifacts"
SMOKE_RUN_DIR="${SMOKE_OUTPUT%.jsonl}_artifacts"
FULL_RUN_DIR="${FULL_OUTPUT%.jsonl}_artifacts"

echo "[2/4] Input dry-run preflight"
run_experiment "dry-run preflight" "$DRY_OUTPUT" "$DRY_RUN_DIR" --dry-run

echo "[3/4] One-question real-model smoke test"
run_experiment "one-question smoke test" "$SMOKE_OUTPUT" "$SMOKE_RUN_DIR" --limit 1

echo "[4/4] Full supplied input set"
run_experiment "full input set" "$FULL_OUTPUT" "$FULL_RUN_DIR"

echo "Completed. Master log: $MASTER_LOG"
